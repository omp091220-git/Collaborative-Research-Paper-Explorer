# ==============================================================================
# Collaborative Research Paper Explorer - Environment Configuration Template
# Copy this file to backend/.env and fill in your environment settings.
# WARNING: NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL 15+ / Neon DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_explorer

# JSON Web Token Secret (FR-02, FR-04, FR-05)
# IMPORTANT: Must be cryptographically secure and at least 32 characters in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long

# Institutional Domain Whitelist (FR-01, FR-02)
# Comma-separated list of allowed domains for institutional accounts / researchers
ALLOWED_EMAIL_DOMAINS=dau.ac.in,university.edu

# Institutional SSO / Google Workspace OIDC (FR-02)
# Leave empty if SSO is not configured on this instance.
# To enable Google Workspace SSO:
# 1. Create OAuth 2.0 Web Application credentials in Google Cloud Console.
# 2. Add Authorized redirect URI: http://localhost:5000/api/auth/sso/callback
# 3. Fill in the client credentials below.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5000/api/auth/sso/callback
OIDC_ISSUER=https://accounts.google.com
OIDC_SCOPES=openid email profile

# Session Management & Idle Inactivity Tracking (FR-04)
# Inactivity timeout enforces automatic logout after 30 minutes of idle time
SESSION_INACTIVITY_TIMEOUT_MS=1800000
# Absolute maximum session lifetime (default 8 hours)
SESSION_MAX_AGE_MS=28800000

# Rate Limiting Configuration
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5

# Email Delivery Configuration (FR-01, FR-03)
# Supported modes:
#   console  - logs time-limited reset links directly to terminal (development default)
#   smtp     - sends emails through configured SMTP transport
#   disabled - disables email delivery
EMAIL_SERVICE_MODE=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Collaborative Research Paper Explorer" <no-reply@university.edu>

# Development Helpers (NEVER enable in production)
EXPOSE_DEV_RESET_TOKEN=false

# Google Gemini AI Summaries (FR-08)
# Server-side only. NEVER expose this key to the frontend or commit it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Per-request timeout in ms (NFR-03 targets 30s end to end for a 20-page PDF)
GEMINI_TIMEOUT_MS=25000
# Safety cap on extracted text sent to Gemini (characters)
GEMINI_MAX_INPUT_CHARS=400000

# FR-08 background summarization queue (Redis + BullMQ)
REDIS_URL=redis://127.0.0.1:6379
SUMMARY_WORKER_CONCURRENCY=2
SUMMARY_RETRY_DELAY_MS=1500
